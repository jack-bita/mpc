# .env.example: every setting a laptop needs, with safe development values (REPO-4).
# Copy it once:  cp .env.example .env   -- then change values in .env, never here.
# .env is gitignored, and this file holds no real secrets: the repo is public (03 §10).
# One file feeds both sides:
#   - Docker Compose reads .env from the repo root by itself (compose.dev.yml);
#   - Django reads it through `uv run --env-file ../.env ...` (the Makefile does this for you).
# The server has its own root-only .env with real values (03 §13); nothing here is used there.
#
# DJANGO_SETTINGS_MODULE is left out on purpose: pytest-django lets that variable beat
# backend/pyproject.toml, so the tests would quietly run on dev settings instead of test settings.
# manage.py already picks the dev settings by itself.

# --- Django
# Signs session cookies and CSRF tokens. Any long text works on a laptop; never reuse it on a server.
DJANGO_SECRET_KEY=dev-only-change-me-not-a-real-secret
# The host names Django answers to. Requests through Caddy arrive as localhost:8080.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (the postgres service in compose.dev.yml)
# Compose creates the database and its owner from these on the first start; Django logs in with them.
DB_NAME=mpc
DB_USER=mpc
# A development-only password; the container is reachable only from this laptop (127.0.0.1).
DB_PASSWORD=mpc-dev-password
# 127.0.0.1, not localhost: the port is published on IPv4 only, and localhost may try IPv6 (::1) first.
DB_HOST=127.0.0.1
# 5433, not PostgreSQL's usual 5432, so a PostgreSQL already installed on the laptop keeps its port.
# Change it here if 5433 is busy too; Compose and Django both read this one value.
DB_PORT=5433
