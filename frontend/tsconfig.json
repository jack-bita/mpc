// tsconfig.json — how TypeScript checks the frontend (`pnpm typecheck`, and `next build`).
//
// TypeScript only checks here; Next.js does the real compiling, so "noEmit" is on.
// Most options are the ones Next.js expects (it rewrites this file if a required one is
// missing). Ours on top: strict mode, and noUncheckedIndexedAccess.
//
// TypeScript 6.0, not 7: typescript-eslint (inside eslint-config-next) supports only
// TypeScript below 6.1 for now.
{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // list[0] has the type "T | undefined", so code must handle a missing item. It catches
    // the "row 0 of an empty list" bug before it reaches money or stock code.
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // "@/lib/rounding" means src/lib/rounding.ts, from any folder depth.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "out"]
}
