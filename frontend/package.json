{
  "name": "mpc-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend of the MPC shop system: a Next.js app built into plain files (a static PWA), Swahili first. next.config.ts explains why it is static.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "gen:api": "pnpm gen:api:schema && pnpm gen:api:types",
    "gen:api:schema": "cd ../backend && uv run python manage.py spectacular --skip-checks --validate --fail-on-warn --format openapi-json --file ../shared/openapi.json",
    "gen:api:types": "openapi-typescript ../shared/openapi.json --output src/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.106.1",
    "big.js": "7.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.13",
    "tw-animate-css": "1.4.0",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@serwist/cli": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/big.js": "7.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
