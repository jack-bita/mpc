    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
