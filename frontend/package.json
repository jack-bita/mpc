{
  "name": "mpc-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend of the MPC shop system: a Next.js app built into plain files (a static PWA), Swahili first. next.config.ts explains why it is static.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "dexie": "4.4.6",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.13",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@serwist/cli": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
