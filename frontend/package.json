{
  "name": "mpc-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend of the MPC shop system: a Next.js app built into plain files (a static PWA), Swahili first. next.config.ts explains why it is static.",
  "packageManager": "pnpm@12.14.0",
